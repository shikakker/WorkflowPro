# Server-only n8n execution configuration.
# Never expose N8N_API_KEY through VITE_* variables or client bundles.
N8N_BASE_URL=https://your-n8n.example.com
N8N_API_KEY=replace-with-server-side-api-key

# Production safety gate. Leave false until an authenticated ownership layer exists.
# Setting true makes same-origin browser execution available to site visitors.
WORKFLOWPRO_ALLOW_PUBLIC_EXECUTION=false

# Also required for any intentionally exposed production pilot:
# Comma-separated exact n8n workflow IDs approved by the operator.
# An unknown ID is denied before using N8N_API_KEY.
WORKFLOWPRO_ALLOWED_N8N_WORKFLOW_IDS=
